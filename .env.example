PORT=3000

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=tu_password
DB_NAME=citas_saas

# JWT: sustituir por un secreto propio, distinto de cada clave HMAC.
JWT_SECRET=REEMPLAZAR_CON_SECRETO_JWT_ALEATORIO_DE_32_CARACTERES
JWT_EXPIRES_IN=12h

# Portal servido bajo el mismo origen; no incluir ruta ni barra final.
PORTAL_PUBLICO_ORIGEN=https://citas.example.test
# Clave independiente de JWT para enlazar CSRF a la cookie anónima.
PORTAL_CSRF_SECRET=REEMPLAZAR_CON_SECRETO_CSRF_ALEATORIO_DE_32_CARACTERES
# Clave independiente y estable para comparar reintentos de formulario sin guardar contacto.
# Conservarla mientras existan intentos pendientes o registrables que deban recuperarse.
PORTAL_FORMULARIO_HMAC_SECRET=REEMPLAZAR_CON_SECRETO_HMAC_FORMULARIO_DE_32_CARACTERES

# Clave independiente y estable para las huellas de intentos manuales y uniones de clientes.
# Conservarla mientras haya operaciones que deban repetirse o resolverse.
CITAS_MANUALES_HMAC_SECRET=REEMPLAZAR_CON_SECRETO_HMAC_MANUAL_DE_32_CARACTERES

# En producción se exigen escrituras expresamente habilitadas. Usar "cerradas"
# durante instalación o incidentes; liberación y recuperación propias siguen disponibles.
PORTAL_PUBLICO_ESCRITURAS=cerradas

# WhatsApp Cloud API. Usar el idioma y los nombres exactos de las plantillas aprobadas en Meta.
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_IDIOMA=es_MX
WHATSAPP_PLANTILLA_PENDIENTE=cita_pendiente
WHATSAPP_PLANTILLA_CONFIRMADA=cita_confirmada
WHATSAPP_PLANTILLA_RECORDATORIO=cita_recordatorio

# Credenciales del webhook /webhooks/whatsapp. Completar solo en el entorno real.
# VERIFY_TOKEN es el valor aleatorio que también se introduce en Meta al verificar la URL.
# APP_SECRET es el secreto de la app de Meta que firma los eventos entrantes.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=

# Mapa JSON de referencias secret:// a tokens de acceso de Meta.
# Ejemplo: '{"secret://whatsapp/piloto":"TOKEN_DE_ACCESO_DE_META"}'
# La referencia debe coincidir con secreto_ref en canales_whatsapp.
# El Phone Number ID se registra en remitente_externo_id de esa misma tabla.
WHATSAPP_SECRETOS_JSON='{}'

# Clave independiente de al menos 32 bytes para el botón de WhatsApp.
# Inyectar una clave aleatoria y conservarla mientras haya botones vigentes.
WHATSAPP_CONFIRMACION_HMAC_SECRET=

# Activaciones independientes después de validar el canal y la política en el entorno.
WHATSAPP_PROCESAR_ENVIOS=deshabilitado
WHATSAPP_CANCELAR_POR_PLAZO=deshabilitado

# Claves de derivacion de codigos, independientes de JWT. Conservar versiones
# antiguas mientras haya codigos o envios pendientes que las necesiten.
# Para rotar: agregar una version nueva, cambiar VERSION_ACTUAL y conservar la anterior.
CODIGOS_HMAC_VERSION_ACTUAL=1
CODIGOS_HMAC_CLAVES='{"1":"cambiar-por-clave-aleatoria-distinta-de-jwt-y-de-al-menos-32-caracteres"}'

# Transporte SMTP. Completar credenciales en el entorno, nunca en el repositorio.
# false exige STARTTLS (habitualmente 587); true usa TLS implícito (habitualmente 465).
CORREO_REMITENTE=sistema@example.test
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=10000
