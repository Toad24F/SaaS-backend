PORT=3000

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=tu_password
DB_NAME=citas_saas

# JWT: sustituir por un secreto propio, distinto de cada clave HMAC.
JWT_SECRET=REEMPLAZAR_CON_SECRETO_JWT_ALEATORIO_DE_32_CARACTERES
JWT_EXPIRES_IN=12h

# Claves de derivacion de codigos, independientes de JWT. Conservar versiones
# antiguas mientras haya codigos o envios pendientes que las necesiten.
# Para rotar: agregar una version nueva, cambiar VERSION_ACTUAL y conservar la anterior.
CODIGOS_HMAC_VERSION_ACTUAL=1
CODIGOS_HMAC_CLAVES='{"1":"cambiar-por-clave-aleatoria-distinta-de-jwt-y-de-al-menos-32-caracteres"}'

# Transporte SMTP. Completar credenciales en el entorno, nunca en el repositorio.
# false exige STARTTLS (habitualmente 587); true usa TLS implícito (habitualmente 465).
CORREO_REMITENTE=sistema@example.test
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=10000
